def titulo(txt):
    print("-" * 10)
    print(txt)
    print("-" * 10)

def soma (a, b):
    s = a + b
    titulo(' SOMA ')
    print(f"a soma de {a} e de {b} = {s}")

def contador (* num):
    tamanho = len(num)
    titulo(' valores ')
    print(f"recebi os valores {num} e sao ao todo {tamanho} numeros")

def dobra(lista):
    pos = 0
    while pos < len(lista):
        lista[pos] *= 2
        pos += 1

